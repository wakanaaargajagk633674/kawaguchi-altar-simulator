# このファイルは例です。実値は .env.local に記載し、.env.local はコミットしないこと。

# --- OpenAI Images（高度AI補正 / AI肖像生成 / AIに全てお任せ）---
# サーバー側のみで使用し、クライアントへ絶対に露出しません／ログにも出しません。
# /api/iei-photo/ai-image が OpenAI Images(edits) を呼び出します。
# OPENAI_API_KEY=
# 画像モデル（未設定なら gpt-image-2 を使用）。
# OPENAI_IMAGE_MODEL=gpt-image-2

# --- OpenAI テキスト生成（葬儀司会台本のナレーション生成）---
# /api/funeral-script/generate-narration が OpenAI Responses API を呼び出します。
# 上の OPENAI_API_KEY を共用します（サーバー側のみ／ログに出しません）。
# テキストモデル（未設定なら gpt-5.5 を使用）。本番(Vercel)では OPENAI_TEXT_MODEL=gpt-5.5 を設定。
# OPENAI_TEXT_MODEL=gpt-5.5

# --- スタッフ用 Basic 認証（必須: 本番 / Preview）---
# /iei-photo・/funeral-script・/api/* を Basic 認証で保護します（proxy.ts）。
# 本番（NODE_ENV=production）で未設定の場合、上記ページ・APIは 503 で閉じます。
# ローカル開発（npm run dev）で未設定なら認証なしで動きます。
# パスワードは十分に長いランダム文字列にしてください。
# STAFF_BASIC_USER=
# STAFF_BASIC_PASS=

# --- レート制限について ---
# AI系API には IP 単位の簡易レート制限（インメモリ、インスタンスごと）を入れていますが、
# 確実ではありません。Vercel Firewall の Rate Limiting ルールを併用してください
# （例: パス /api/iei-photo/ai-image と /api/funeral-script/ を対象に IP 単位で 1分 10回）。

# --- rembg ワーカー（workers/rembg-worker、RunPod/VPS 側の環境変数）---
# REMBG_WORKER_TOKEN（必須）: 未設定だと worker は起動時に終了します。Next.js 側と同じ値に。
# REMBG_ALLOW_NO_AUTH=1   … ローカル開発専用のオプトアウト（本番では設定しない）
# REMBG_MAX_UPLOAD_BYTES  … アップロード上限（既定 15MB）
